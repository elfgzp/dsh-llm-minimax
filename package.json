{
  "name": "dsh-llm-minimax",
  "version": "0.2.0",
  "private": true,
  "description": "MiniMax open-platform models for DeepSeek Harness: paste the API key in Settings → MiniMax, get MiniMax-M3.1-Flash / M3 in the model picker, and see M Plan quota windows. Keeps several API keys with your own remark names and switches which one is in use.",
  "keywords": ["dsh-plugin", "deepseek-harness", "minimax", "llm"],
  "author": "Elf <gzp741424975@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elfgzp/dsh-llm-minimax.git"
  },
  "homepage": "https://github.com/elfgzp/dsh-llm-minimax#readme",
  "bugs": "https://github.com/elfgzp/dsh-llm-minimax/issues",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "test/*.js",
    "docs/*.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "license": "MIT"
}
